{
  "info": {
    "name": "Fuel Route API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Trip plan + ELD logs (multi-day)",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"current_location\": \"Dallas, TX\",\n  \"pickup_location\": \"Oklahoma City, OK\",\n  \"dropoff_location\": \"Chicago, IL\",\n  \"current_cycle_used_hours\": 20,\n  \"start_time\": \"2026-06-15T08:00:00\"\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:8000/api/v1/trip-plan",
          "protocol": "http",
          "host": ["127.0.0.1"],
          "port": "8000",
          "path": ["api", "v1", "trip-plan"]
        }
      }
    },
    {
      "name": "Trip plan + ELD logs (cross-country, restart)",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"current_location\": \"Los Angeles, CA\",\n  \"pickup_location\": \"Phoenix, AZ\",\n  \"dropoff_location\": \"New York, NY\",\n  \"current_cycle_used_hours\": 55\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:8000/api/v1/trip-plan",
          "protocol": "http",
          "host": ["127.0.0.1"],
          "port": "8000",
          "path": ["api", "v1", "trip-plan"]
        }
      }
    },
    {
      "name": "Plan fuel route (long, multiple stops)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://127.0.0.1:8000/api/v1/fuel-route?start=Los Angeles, CA&finish=New York, NY",
          "protocol": "http",
          "host": ["127.0.0.1"],
          "port": "8000",
          "path": ["api", "v1", "fuel-route"],
          "query": [
            {"key": "start", "value": "Los Angeles, CA"},
            {"key": "finish", "value": "New York, NY"}
          ]
        }
      }
    },
    {
      "name": "Plan fuel route (medium)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://127.0.0.1:8000/api/v1/fuel-route?start=Dallas, TX&finish=Chicago, IL",
          "protocol": "http",
          "host": ["127.0.0.1"],
          "port": "8000",
          "path": ["api", "v1", "fuel-route"],
          "query": [
            {"key": "start", "value": "Dallas, TX"},
            {"key": "finish", "value": "Chicago, IL"}
          ]
        }
      }
    },
    {
      "name": "Short route (no stops needed)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://127.0.0.1:8000/api/v1/fuel-route?start=Los Angeles, CA&finish=Las Vegas, NV",
          "protocol": "http",
          "host": ["127.0.0.1"],
          "port": "8000",
          "path": ["api", "v1", "fuel-route"],
          "query": [
            {"key": "start", "value": "Los Angeles, CA"},
            {"key": "finish", "value": "Las Vegas, NV"}
          ]
        }
      }
    },
    {
      "name": "Coordinates input (zero geocoding calls)",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"32.7767,-96.797\",\n  \"finish\": \"41.8781,-87.6298\"\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:8000/api/v1/fuel-route",
          "protocol": "http",
          "host": ["127.0.0.1"],
          "port": "8000",
          "path": ["api", "v1", "fuel-route"]
        }
      }
    }
  ]
}
